{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZXR asset brief v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "zxr-asset-brief-v1"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "id": {
      "$ref": "#/$defs/node"
    },
    "kind": {
      "enum": [
        "prop",
        "character",
        "scenery"
      ]
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      },
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sizeMetres": {
      "$ref": "#/$defs/size"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/node"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "colour": {
            "$ref": "#/$defs/colour"
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "metalness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "name",
          "description",
          "colour",
          "roughness",
          "metalness"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 512
    },
    "requiredClips": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*$",
        "maxLength": 100
      },
      "minItems": 0,
      "maxItems": 512,
      "uniqueItems": true
    },
    "hotspotNodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "$ref": "#/$defs/node"
          },
          "shape": {
            "enum": [
              "box",
              "sphere"
            ]
          },
          "sizeMetres": {
            "$ref": "#/$defs/size"
          },
          "pose": {
            "$ref": "#/$defs/pose"
          }
        },
        "required": [
          "node",
          "shape",
          "sizeMetres",
          "pose"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 512
    }
  },
  "required": [
    "format",
    "provenance",
    "review",
    "id",
    "kind",
    "objects",
    "description",
    "sizeMetres",
    "materials",
    "requiredClips",
    "hotspotNodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9?$!#-]*$",
      "maxLength": 100
    },
    "node": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
      "maxLength": 100
    },
    "position": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -10000,
        "maximum": 10000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "size": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0.001,
        "maximum": 10000
      },
      "minItems": 3,
      "maxItems": 3
    },
    "pose": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/position"
        },
        "yawDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": [
        "position",
        "yawDegrees"
      ],
      "additionalProperties": false
    },
    "colour": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "provenance": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "manual"
            },
            "author": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          },
          "required": [
            "method",
            "author"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "model"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "inputHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "method",
            "model",
            "promptVersion",
            "inputHash"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "const": "assistant"
            },
            "agent": {
              "const": "Codex"
            },
            "model": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ]
            },
            "promptVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "inputHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "method",
            "agent",
            "model",
            "promptVersion",
            "inputHash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "draft"
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "approved"
            },
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "reviewedOn": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          },
          "required": [
            "status",
            "reviewer",
            "reviewedOn"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "flag"
            },
            "object": {
              "$ref": "#/$defs/symbol"
            },
            "flag": {
              "$ref": "#/$defs/symbol"
            },
            "set": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "object",
            "flag",
            "set"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "global"
            },
            "name": {
              "$ref": "#/$defs/symbol"
            },
            "equals": {
              "type": "integer",
              "minimum": -32768,
              "maximum": 65535
            }
          },
          "required": [
            "kind",
            "name",
            "equals"
          ],
          "additionalProperties": false
        }
      ]
    },
    "light": {
      "type": "object",
      "properties": {
        "node": {
          "$ref": "#/$defs/node"
        },
        "kind": {
          "enum": [
            "ambient",
            "point",
            "directional"
          ]
        },
        "colour": {
          "$ref": "#/$defs/colour"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      },
      "required": [
        "node",
        "kind",
        "colour",
        "intensity",
        "position"
      ],
      "additionalProperties": false
    }
  }
}
